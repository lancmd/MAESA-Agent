{
  "schema_version": 2,
  "project_id": "my-mining-classification-invest-study",
  "task_type": "classification_invest",
  "workspace": "runtime",
  "security": {
    "input_roots": ["data"],
    "output_root": "runtime",
    "confirm_overwrite": false
  },
  "inputs": {
    "imagery": [],
    "imagery_periods": [
      {"year": 2000, "path": "data/imagery/Landsat_2000.tif", "sensor": "landsat_5_tm", "training_roi": "data/roi/roi_2000.gpkg", "accuracy": {"enabled": true, "validation_samples": "data/validation/validation_2000.csv", "reference_field": "reference", "prediction_field": "prediction", "x_field": "x", "y_field": "y", "samples_crs": "EPSG:32650"}},
      {"year": 2005, "path": "data/imagery/Landsat_2005.tif", "sensor": "landsat_5_tm", "training_roi": "data/roi/roi_2005.gpkg", "accuracy": {"enabled": true, "validation_samples": "data/validation/validation_2005.csv", "reference_field": "reference", "prediction_field": "prediction", "x_field": "x", "y_field": "y", "samples_crs": "EPSG:32650"}},
      {"year": 2010, "path": "data/imagery/Landsat_2010.tif", "sensor": "landsat_5_tm", "training_roi": "data/roi/roi_2010.gpkg", "accuracy": {"enabled": true, "validation_samples": "data/validation/validation_2010.csv", "reference_field": "reference", "prediction_field": "prediction", "x_field": "x", "y_field": "y", "samples_crs": "EPSG:32650"}},
      {"year": 2015, "path": "data/imagery/Landsat_2015.tif", "sensor": "landsat_8_oli", "training_roi": "data/roi/roi_2015.gpkg", "accuracy": {"enabled": true, "validation_samples": "data/validation/validation_2015.csv", "reference_field": "reference", "prediction_field": "prediction", "x_field": "x", "y_field": "y", "samples_crs": "EPSG:32650"}},
      {"year": 2020, "path": "data/imagery/Landsat_2020.tif", "sensor": "landsat_8_oli", "training_roi": "data/roi/roi_2020.gpkg", "accuracy": {"enabled": true, "validation_samples": "data/validation/validation_2020.csv", "reference_field": "reference", "prediction_field": "prediction", "x_field": "x", "y_field": "y", "samples_crs": "EPSG:32650"}},
      {"year": 2025, "path": "data/imagery/Sentinel2_2025.tif", "sensor": "sentinel_2_msi", "training_roi": "data/roi/roi_2025.gpkg", "accuracy": {"enabled": true, "validation_samples": "data/validation/validation_2025.csv", "reference_field": "reference", "prediction_field": "prediction", "x_field": "x", "y_field": "y", "samples_crs": "EPSG:32650"}}
    ],
    "mine_boundary": "data/boundaries/mine_boundary.gpkg",
    "carbon_density": "data/invest/carbon_density.csv",
    "lulc_baseline": null,
    "historical_lulc": [],
    "historical_lulc_periods": [],
    "training_roi": null,
    "model_package": null,
    "dem": "data/drivers/dem_30m.tif",
    "driver_factors": {
      "dem": "data/drivers/dem_30m.tif",
      "road_distance": "data/drivers/road_distance_30m.tif",
      "river_distance": "data/drivers/river_distance_30m.tif"
    }
  },
  "classification": {
    "enabled": true,
    "engine": "envi",
    "scheme": "high_water_coal_7class",
    "envi_method": "maximum_likelihood",
    "output_lulc": "outputs/lulc/LULC_{year}.tif",
    "output_confidence": "outputs/lulc/LULC_confidence_{year}.tif",
    "roi_quality": {
      "enabled": true,
      "class_field": "class_id",
      "minimum_rois_per_class": 30,
      "max_class_imbalance_ratio": 10.0,
      "preflight_output": "outputs/validation/classification_input_preflight_{year}.json"
    }
  },
  "plus": {"enabled": false},
  "invest": {
    "enabled": true,
    "output_workspace": "outputs/invest",
    "models": {
      "carbon": {"enabled": true, "service_unit": "Mg C"},
      "habitat_quality": {"enabled": true, "datastack_builder": "data/invest/habitat_quality.json", "service_unit": "index_0_to_1", "service_aggregation": "mean"}
    },
    "multiperiod_summary": {"enabled": true, "output_table": "outputs/statistics/invest_multiperiod_summary.csv", "output_figure": "outputs/figures/invest_multiperiod_change.svg"}
  },
  "subsidence_water": {"enabled": false},
  "ecosystem_service": {"enabled": false},
  "gis_outputs": {"enabled": false},
  "validation": {"enabled": true, "output_report": "outputs/validation/analysis_validation_report.json"}
}
